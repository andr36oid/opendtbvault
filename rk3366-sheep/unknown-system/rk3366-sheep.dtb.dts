/dts-v1/;

/ {
	compatible = "rockchip,sheep\0rockchip,rk3366";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Rockchip SDK sheep board";

	aliases {
		i2c0 = "/i2c@ff650000";
		i2c1 = "/i2c@ff660000";
		i2c2 = "/i2c@ff140000";
		i2c3 = "/i2c@ff150000";
		i2c4 = "/i2c@ff160000";
		i2c5 = "/i2c@ff170000";
		serial0 = "/serial@ff180000";
		serial2 = "/serial@ff690000";
		serial3 = "/serial@ff1b0000";
		spi0 = "/spi@ff110000";
		spi1 = "/spi@ff120000";
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			clocks = <0x02 0x09>;
			operating-points-v2 = <0x03>;
			cpu-idle-states = <0x04 0x05>;
			#cooling-cells = <0x02>;
			dynamic-power-coefficient = <0xa6>;
			cpu-supply = <0x06>;
			phandle = <0x08>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x01>;
			enable-method = "psci";
			operating-points-v2 = <0x03>;
			cpu-idle-states = <0x04 0x05>;
			cpu-supply = <0x06>;
			phandle = <0x09>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x02>;
			enable-method = "psci";
			operating-points-v2 = <0x03>;
			cpu-idle-states = <0x04 0x05>;
			cpu-supply = <0x06>;
			phandle = <0x0a>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53\0arm,armv8";
			reg = <0x00 0x03>;
			enable-method = "psci";
			operating-points-v2 = <0x03>;
			cpu-idle-states = <0x04 0x05>;
			cpu-supply = <0x06>;
			phandle = <0x0b>;
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x10000>;
				entry-latency-us = <0x78>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x384>;
				phandle = <0x04>;
			};

			cluster-sleep {
				compatible = "arm,idle-state";
				local-timer-stop;
				arm,psci-suspend-param = <0x1010000>;
				entry-latency-us = <0x190>;
				exit-latency-us = <0x1f4>;
				min-residency-us = <0x7d0>;
				phandle = <0x05>;
			};
		};
	};

	opp_table0 {
		compatible = "operating-points-v2";
		opp-shared;
		nvmem-cells = <0x07>;
		nvmem-cell-names = "cpu_leakage";
		phandle = <0x03>;

		opp-408000000 {
			opp-hz = <0x00 0x18519600>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0x1312d0>;
			clock-latency-ns = <0x9c40>;
			opp-suspend;
		};

		opp-600000000 {
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt = <0xe7ef0 0xe7ef0 0x1312d0>;
		};

		opp-816000000 {
			opp-hz = <0x00 0x30a32c00>;
			opp-microvolt = <0xf4240 0xf4240 0x1312d0>;
		};

		opp-1008000000 {
			opp-hz = <0x00 0x3c14dc00>;
			opp-microvolt = <0x106738 0x106738 0x1312d0>;
		};

		opp-1200000000 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt = <0x11edd8 0x11edd8 0x1312d0>;
		};

		opp-1296000000 {
			opp-hz = <0x00 0x4d3f6400>;
			opp-microvolt = <0x1312d0 0x1312d0 0x1312d0>;
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xf04 0x01 0x0e 0xf04 0x01 0x0b 0xf04 0x01 0x0a 0xf04>;
	};

	arm-pmu {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <0x00 0x70 0x04 0x00 0x71 0x04 0x00 0x72 0x04 0x00 0x73 0x04>;
		interrupt-affinity = <0x08 0x09 0x0a 0x0b>;
	};

	xin24m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		clock-output-names = "xin24m";
		phandle = <0x8b>;
	};

	interrupt-controller@ffb71000 {
		compatible = "arm,gic-400";
		interrupt-controller;
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		reg = <0x00 0xffb71000 0x00 0x1000 0x00 0xffb72000 0x00 0x1000 0x00 0xffb74000 0x00 0x2000 0x00 0xffb76000 0x00 0x2000>;
		interrupts = <0x01 0x09 0xf04>;
		phandle = <0x01>;
	};

	nandc@ff0c0000 {
		compatible = "rockchip,rk-nandc";
		reg = <0x00 0xff0c0000 0x00 0x4000>;
		interrupts = <0x00 0x26 0x04>;
		nandc_id = <0x00>;
		clocks = <0x02 0x64 0x02 0x1ca>;
		clock-names = "clk_nandc\0hclk_nandc";
		status = "okay";
		phandle = <0x8c>;
	};

	saradc@ff100000 {
		compatible = "rockchip,saradc";
		reg = <0x00 0xff100000 0x00 0x100>;
		interrupts = <0x00 0x24 0x04>;
		#io-channel-cells = <0x01>;
		clocks = <0x02 0x63 0x02 0x161>;
		clock-names = "saradc\0apb_pclk";
		status = "okay";
		phandle = <0x7f>;
	};

	spi@ff110000 {
		compatible = "rockchip,rk3368-spi\0rockchip,rk3066-spi";
		reg = <0x00 0xff110000 0x00 0x1000>;
		clocks = <0x02 0x4e 0x02 0x156>;
		clock-names = "spiclk\0apb_pclk";
		interrupts = <0x00 0x2c 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0x0c 0x0d 0x0e 0x0f>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "disabled";
		phandle = <0x8d>;
	};

	spi@ff120000 {
		compatible = "rockchip,rk3368-spi\0rockchip,rk3066-spi";
		reg = <0x00 0xff120000 0x00 0x1000>;
		clocks = <0x02 0x4f 0x02 0x157>;
		clock-names = "spiclk\0apb_pclk";
		interrupts = <0x00 0x2d 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0x10 0x11 0x12 0x13>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "disabled";
		phandle = <0x8e>;
	};

	rkscr@ff1d0000 {
		compatible = "rockchip-scr";
		reg = <0x00 0xff1d0000 0x00 0x10000>;
		interrupts = <0x00 0x2b 0x04>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x14 0x15 0x16 0x17>;
		clocks = <0x02 0x163>;
		clock-names = "g_pclk_sim_card";
		status = "disabled";
		phandle = <0x8f>;
	};

	thermal-zones {

		soc-thermal {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			sustainable-power = <0x640>;
			thermal-sensors = <0x18 0x00>;
			phandle = <0x90>;

			trips {

				trip-point-0 {
					temperature = <0x11170>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x91>;
				};

				trip-point-1 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x19>;
				};

				soc-crit {
					temperature = <0x1c138>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x92>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x19>;
					cooling-device = <0x08 0xffffffff 0xffffffff>;
				};

				map1 {
					trip = <0x19>;
					cooling-device = <0x1a 0xffffffff 0xffffffff>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x18 0x01>;
			phandle = <0x93>;
		};
	};

	tsadc@ff260000 {
		compatible = "rockchip,rk3366-tsadc";
		reg = <0x00 0xff260000 0x00 0x100>;
		interrupts = <0x00 0x25 0x04>;
		clocks = <0x02 0x62 0x02 0x162>;
		clock-names = "tsadc\0apb_pclk";
		resets = <0x02 0x8e>;
		reset-names = "tsadc-apb";
		pinctrl-names = "gpio\0otpout";
		pinctrl-0 = <0x1b>;
		pinctrl-1 = <0x1c>;
		#thermal-sensor-cells = <0x01>;
		rockchip,hw-tshut-temp = <0x1d4c0>;
		status = "okay";
		phandle = <0x18>;
	};

	dwmmc@ff400000 {
		compatible = "rockchip,rk3366-dw-mshc\0rockchip,rk3288-dw-mshc";
		clock-freq-min-max = <0x61a80 0x23c3460>;
		clocks = <0x02 0x1c7 0x02 0x51 0x02 0x55 0x02 0x56>;
		clock-names = "biu\0ciu\0ciu-drive\0ciu-sample";
		fifo-depth = <0x100>;
		interrupts = <0x00 0x20 0x04>;
		reg = <0x00 0xff400000 0x00 0x4000>;
		status = "okay";
		clock-frequency = <0x23c3460>;
		supports-sd;
		bus-width = <0x04>;
		cap-mmc-highspeed;
		cap-sd-highspeed;
		card-detect-delay = <0xc8>;
		disable-wp;
		num-slots = <0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x1d 0x1e 0x1f 0x20>;
		phandle = <0x94>;
	};

	dwmmc@ff410000 {
		compatible = "rockchip,rk3366-dw-mshc\0rockchip,rk3288-dw-mshc";
		clock-freq-min-max = <0x30d40 0x23c3460>;
		clocks = <0x02 0x1c8 0x02 0x52 0x02 0x57 0x02 0x58>;
		clock-names = "biu\0ciu\0ciu-drive\0ciu-sample";
		fifo-depth = <0x100>;
		interrupts = <0x00 0x21 0x04>;
		reg = <0x00 0xff410000 0x00 0x4000>;
		status = "okay";
		clock-frequency = <0x23c3460>;
		supports-sdio;
		bus-width = <0x04>;
		disable-wp;
		cap-sd-highspeed;
		cap-sdio-irq;
		keep-power-in-suspend;
		mmc-pwrseq = <0x21>;
		non-removable;
		num-slots = <0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x22 0x23 0x24>;
		sd-uhs-sdr104;
		phandle = <0x95>;
	};

	dwmmc@ff420000 {
		compatible = "rockchip,rk3366-dw-mshc\0rockchip,rk3288-dw-mshc";
		clock-freq-min-max = <0x61a80 0x5f5e100>;
		clocks = <0x02 0x1c9 0x02 0x54 0x02 0x5b 0x02 0x5c>;
		clock-names = "biu\0ciu\0ciu-drive\0ciu-sample";
		fifo-depth = <0x100>;
		interrupts = <0x00 0x23 0x04>;
		reg = <0x00 0xff420000 0x00 0x4000>;
		status = "okay";
		clock-frequency = <0x5f5e100>;
		supports-emmc;
		bus-width = <0x08>;
		cap-mmc-highspeed;
		disable-wp;
		non-removable;
		num-slots = <0x01>;
		pinctrl-names = "default";
		pinctrl-0 = <0x25 0x26 0x27 0x28>;
		phandle = <0x96>;
	};

	eth@ff440000 {
		compatible = "rockchip,rk3366-gmac";
		reg = <0x00 0xff440000 0x00 0x10000>;
		rockchip,grf = <0x29>;
		interrupts = <0x00 0x1b 0x04>;
		interrupt-names = "macirq";
		clocks = <0x02 0x6b 0x02 0x6e 0x02 0x6f 0x02 0x6d 0x02 0x6c 0x02 0xc7 0x02 0x155>;
		clock-names = "stmmaceth\0mac_clk_rx\0mac_clk_tx\0clk_mac_ref\0clk_mac_refout\0aclk_mac\0pclk_mac";
		resets = <0x02 0x42>;
		reset-names = "stmmaceth";
		status = "okay";
		phy-supply = <0x2a>;
		phy-mode = "rgmii";
		clock_in_out = "input";
		snps,reset-gpio = <0x2b 0x0f 0x01>;
		snps,reset-active-low;
		snps,reset-delays-us = <0x00 0x2710 0xc350>;
		assigned-clocks = <0x02 0x6b>;
		assigned-clock-parents = <0x2c>;
		pinctrl-names = "default";
		pinctrl-0 = <0x2d>;
		tx_delay = <0x25>;
		rx_delay = <0x1d>;
		phandle = <0x97>;
	};

	i2c@ff650000 {
		compatible = "rockchip,rk3368-i2c\0rockchip,rk3288-i2c";
		reg = <0x00 0xff728000 0x00 0x1000>;
		clocks = <0x02 0x158>;
		clock-names = "i2c";
		interrupts = <0x00 0x3c 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0x2e>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		i2c-scl-rising-time-ns = <0xfa>;
		i2c-scl-falling-time-ns = <0x14>;
		phandle = <0x98>;

		syr827@40 {
			regulator-name = "vdd_arm";
			compatible = "silergy,syr827";
			status = "okay";
			reg = <0x40>;
			regulator-compatible = "fan53555-reg";
			regulator-min-microvolt = <0xadf34>;
			regulator-max-microvolt = <0x16e360>;
			fcs,suspend-voltage-selector = <0x01>;
			regulator-always-on;
			regulator-boot-on;
			regulator-initial-state = <0x03>;
			regulator-ramp-delay = <0x7d0>;
			phandle = <0x06>;

			regulator-state-mem {
				regulator-off-in-suspend;
				regulator-suspend-microvolt = <0xdbba0>;
			};
		};

		pmic@1c {
			compatible = "rockchip,rk818";
			status = "okay";
			reg = <0x1c>;
			clock-output-names = "rk818-clkout1\0wifibt_32kin";
			interrupt-parent = <0x2f>;
			interrupts = <0x02 0x08>;
			pinctrl-names = "default";
			pinctrl-0 = <0x30>;
			rockchip,system-power-controller;
			wakeup-source;
			#clock-cells = <0x01>;
			vcc1-supply = <0x31>;
			vcc2-supply = <0x31>;
			vcc3-supply = <0x31>;
			vcc4-supply = <0x31>;
			vcc6-supply = <0x31>;
			vcc7-supply = <0x31>;
			vcc8-supply = <0x31>;
			vcc9-supply = <0x32>;
			phandle = <0x86>;

			regulators {

				DCDC_REG1 {
					regulator-name = "vdd_logic";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xb71b0>;
					regulator-max-microvolt = <0x162010>;
					regulator-ramp-delay = <0x1771>;
					phandle = <0x74>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0xf4240>;
					};
				};

				DCDC_REG2 {
					regulator-name = "vdd_gpu";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = "\0\f5";
					regulator-max-microvolt = <0x1312d0>;
					regulator-ramp-delay = <0x1771>;
					phandle = <0x99>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0xf4240>;
					};
				};

				DCDC_REG3 {
					regulator-name = "vcc_ddr";
					regulator-always-on;
					regulator-boot-on;
					phandle = <0x9a>;

					regulator-state-mem {
						regulator-on-in-suspend;
					};
				};

				DCDC_REG4 {
					regulator-name = "vcc_io";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					phandle = <0x32>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x325aa0>;
					};
				};

				LDO_REG1 {
					regulator-name = "vcca_codec";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x325aa0>;
					regulator-max-microvolt = <0x325aa0>;
					phandle = <0x9b>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x325aa0>;
					};
				};

				LDO_REG2 {
					regulator-name = "vcc_tp";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x2dc6c0>;
					regulator-max-microvolt = <0x2dc6c0>;
					phandle = <0x7d>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x2dc6c0>;
					};
				};

				LDO_REG3 {
					regulator-name = "vdd_10";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xf4240>;
					regulator-max-microvolt = <0xf4240>;
					phandle = <0x9c>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0xf4240>;
					};
				};

				LDO_REG4 {
					regulator-name = "vcc18_lcd";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					phandle = <0x9d>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x1b7740>;
					};
				};

				LDO_REG5 {
					regulator-name = "vccio_pmu";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					phandle = <0x9e>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x1b7740>;
					};
				};

				LDO_REG6 {
					regulator-name = "vdd10_lcd";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0xf4240>;
					regulator-max-microvolt = <0xf4240>;
					phandle = <0x9f>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0xf4240>;
					};
				};

				LDO_REG7 {
					regulator-name = "vcc_18";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x1b7740>;
					phandle = <0x76>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x1b7740>;
					};
				};

				LDO_REG8 {
					regulator-name = "vccio_wl";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x325aa0>;
					phandle = <0x77>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x325aa0>;
					};
				};

				LDO_REG9 {
					regulator-name = "vccio_sd";
					regulator-always-on;
					regulator-boot-on;
					regulator-min-microvolt = <0x1b7740>;
					regulator-max-microvolt = <0x325aa0>;
					phandle = <0x78>;

					regulator-state-mem {
						regulator-on-in-suspend;
						regulator-suspend-microvolt = <0x325aa0>;
					};
				};

				SWITCH_REG {
					regulator-name = "vcc_sd";
					regulator-always-on;
					regulator-boot-on;
					phandle = <0xa0>;

					regulator-state-mem {
						regulator-on-in-suspend;
					};
				};
			};

			battery {
				compatible = "rk818-battery";
