	dwc-control-usb {
		compatible = "rockchip,rk3368-dwc-control-usb";
		rockchip,grf = <0x29>;
		grf-offset = <0x49c>;
		interrupts = <0x00 0x5d 0x04 0x00 0x5e 0x04 0x00 0x5f 0x04 0x00 0x60 0x04>;
		interrupt-names = "otg_id\0otg_bvalid\0otg_linestate\0host0_linestate";
		clocks = <0x02 0x79 0x02 0x1c5>;
		clock-names = "sclk_otgphy0\0otg";
		otg_drv_gpio = <0x2f 0x0a 0x01>;
		rockchip,remote_wakeup;
		rockchip,usb_irq_wakeup;
		phandle = <0xde>;

		usb_bc {
			compatible = "inno,phy";
			regbase = "/dwc-control-usb";
			rk_usb,bvalid = <0x49c 0x17 0x01>;
			rk_usb,iddig = <0x49c 0x1a 0x01>;
			rk_usb,vdmsrcen = <0x718 0x0c 0x01>;
			rk_usb,vdpsrcen = <0x718 0x0b 0x01>;
			rk_usb,rdmpden = <0x718 0x0a 0x01>;
			rk_usb,idpsrcen = <0x718 0x09 0x01>;
			rk_usb,idmsinken = <0x718 0x08 0x01>;
			rk_usb,idpsinken = <0x718 0x07 0x01>;
			rk_usb,dpattach = <0x498 0x1f 0x01>;
			rk_usb,cpdet = <0x498 0x1e 0x01>;
			rk_usb,dcpattach = <0x498 0x1d 0x01>;
		};
	};

	external-gmac-clock {
		compatible = "fixed-clock";
		clock-frequency = <0x7735940>;
		clock-output-names = "ext_gmac";
		#clock-cells = <0x00>;
		phandle = <0x2c>;
	};

	ion {
		compatible = "rockchip,ion";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cma-heap {
			reg = <0x00 0x2000000>;
		};

		system-heap {
		};
	};

	io-domains {
		compatible = "rockchip,rk3366-io-voltage-domain";
		rockchip,grf = <0x29>;
		lcdc-supply = <0x32>;
		dvpts-supply = <0x76>;
		wifibt-supply = <0x77>;
		audio-supply = <0x32>;
		sdcard-supply = <0x78>;
		tphdsor-supply = <0x32>;
	};

	i2c@2 {
		compatible = "i2c-gpio";
		gpios = <0x79 0x0f 0x00 0x79 0x10 0x00>;
		i2c-gpio,delay-us = <0x02>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x7a>;
		status = "disabled";

		mpu6050@68 {
			status = "disabled";
			compatible = "invensense,mpu6050";
			pinctrl-names = "default";
			pinctrl-0 = <0x7b>;
			reg = <0x68>;
			irq-gpio = <0x79 0x12 0x01>;
			mpu-int_config = <0x10>;
			mpu-level_shifter = <0x00>;
			mpu-orientation = <0x00 0x01 0x00 0x01 0x00 0x00 0x00 0x00 0x01>;
			orientation-x = <0x00>;
			orientation-y = <0x01>;
			orientation-z = <0x00>;
			support-hw-poweroff = <0x00>;
			mpu-debug = <0x01>;
		};
	};

	i2c@4 {
		compatible = "i2c-gpio";
		gpios = <0x79 0x09 0x00 0x79 0x08 0x00>;
		i2c-gpio,delay-us = <0x02>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x7c>;
		status = "okay";

		gt9xx@14 {
			compatible = "goodix,gt9xx";
			reg = <0x14>;
			touch-gpio = <0x79 0x0b 0x08>;
			reset-gpio = <0x79 0x0a 0x00>;
			max-x = <0x4b0>;
			max-y = <0x76c>;
			tp-size = <0x38f>;
			tp-supply = <0x7d>;
			status = "okay";
			phandle = <0xdf>;
		};
	};

	ramoops_mem {
		reg = <0x00 0x100000 0x00 0x100000>;
		reg-names = "ramoops_mem";
		phandle = <0x7e>;
	};

	ramoops {
		compatible = "ramoops";
		record-size = <0x00 0x10000>;
		console-size = <0x00 0x80000>;
		ftrace-size = <0x00 0x10000>;
		pmsg-size = <0x00 0x50000>;
		memory-region = <0x7e>;
	};

	rockchip-key {
		compatible = "rockchip,key";
		status = "okay";
		io-channels = <0x7f 0x01>;
		phandle = <0xe0>;

		vol-up-key {
			linux,code = <0x73>;
			label = "volume up";
			rockchip,adc_value = <0x01>;
		};

		vol-down-key {
			linux,code = <0x72>;
			label = "volume down";
			rockchip,adc_value = <0xaa>;
		};

		power-key {
			gpios = <0x2f 0x0b 0x01>;
			linux,code = <0x74>;
			label = "power";
			gpio-key,wakeup;
		};

		menu-key {
			linux,code = <0x3b>;
			label = "menu";
			rockchip,adc_value = <0x163>;
		};

		home-key {
			linux,code = <0x66>;
			label = "home";
			rockchip,adc_value = <0x2ea>;
		};

		back-key {
			linux,code = <0x9e>;
			label = "back";
			rockchip,adc_value = <0x230>;
		};

		camera-key {
			linux,code = <0xd4>;
			label = "camera";
			rockchip,adc_value = <0x1c2>;
		};
	};

	rt5640-sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,name = "rockchip,rt5640-codec";
		simple-audio-card,mclk-fs = <0x100>;
		simple-audio-card,widgets = "Microphone\0Mic Jack\0Headphone\0Headphone Jack";
		simple-audio-card,routing = "Mic Jack\0MICBIAS1\0IN1P\0Mic Jack\0Headphone Jack\0HPOL\0Headphone Jack\0HPOR";

		simple-audio-card,cpu {
			sound-dai = <0x80>;
		};

		simple-audio-card,codec {
			sound-dai = <0x81>;
		};
	};

	spdif-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip,spdif";

		simple-audio-card,cpu {
			sound-dai = <0x82>;
		};

		simple-audio-card,codec {
			sound-dai = <0x83>;
		};
	};

	spdif-out {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0x00>;
		phandle = <0x83>;
	};

	vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x39fbc0>;
		regulator-max-microvolt = <0x39fbc0>;
		phandle = <0x31>;
	};

	vbus-host-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x2f 0x10 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x84>;
		regulator-name = "vbus_host";
		phandle = <0x53>;
	};

	vcc-phy-regulator {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x2f 0x19 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x85>;
		regulator-name = "vcc_phy";
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x2a>;
	};

	xin32k {
		compatible = "fixed-clock";
		clock-frequency = <0x8000>;
		clock-output-names = "xin32k";
		#clock-cells = <0x00>;
		phandle = <0xe1>;
	};

	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <0x86 0x01>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <0x87>;
		reset-gpios = <0x2f 0x0e 0x01>;
		phandle = <0x21>;
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <0x29>;
		wifi_chip_type = "ap6335";
		sdio_vref = <0x708>;
		WIFI,host_wake_irq = <0x88 0x14 0x00>;
		status = "okay";
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <0x88 0x0b 0x01>;
		pinctrl-names = "default\0rts_gpio";
		pinctrl-0 = <0x89>;
		pinctrl-1 = <0x8a>;
		BT,reset_gpio = <0x88 0x13 0x00>;
		BT,wake_gpio = <0x88 0x12 0x00>;
		BT,wake_host_irq = <0x88 0x15 0x00>;
		status = "okay";
	};

	__symbols__ {
		cpu0 = "/cpus/cpu@0";
		cpu1 = "/cpus/cpu@1";
		cpu2 = "/cpus/cpu@2";
