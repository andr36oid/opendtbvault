			};

			cif-d2d9-m0 {
				rockchip,pins = <0x02 0x04 0x01 0x49 0x02 0x05 0x01 0x49 0x02 0x06 0x01 0x49 0x02 0x07 0x01 0x49 0x02 0x08 0x01 0x49 0x02 0x09 0x01 0x49 0x02 0x0a 0x01 0x49 0x02 0x0b 0x01 0x49 0x02 0x0c 0x01 0x49 0x02 0x0d 0x01 0x49 0x02 0x0e 0x01 0x49>;
				phandle = <0x83>;
			};

			cif-d0d1-m0 {
				rockchip,pins = <0x02 0x10 0x01 0x49 0x02 0x11 0x01 0x49>;
				phandle = <0x84>;
			};
		};

		i2c0 {

			i2c0-xfer {
				rockchip,pins = <0x00 0x09 0x01 0x4a 0x00 0x08 0x01 0x4a>;
				phandle = <0x29>;
			};
		};

		i2c1 {

			i2c1-xfer {
				rockchip,pins = <0x00 0x11 0x01 0x4a 0x00 0x10 0x01 0x4a>;
				phandle = <0x2a>;
			};
		};

		i2c3 {

			i2c3-xfer {
				rockchip,pins = <0x02 0x19 0x01 0x4a 0x02 0x18 0x01 0x4a>;
				phandle = <0x2f>;
			};
		};

		pciusb {

			pciusb-pins {
				rockchip,pins = <0x04 0x0c 0x03 0x49 0x04 0x0d 0x03 0x49 0x04 0x0e 0x03 0x49 0x04 0x0f 0x03 0x49 0x04 0x10 0x03 0x49 0x04 0x11 0x03 0x49 0x04 0x12 0x03 0x49 0x04 0x13 0x03 0x49>;
				phandle = <0x85>;
			};

			pcie-clkreq {
				rockchip,pins = <0x00 0x16 0x01 0x49>;
				phandle = <0x0d>;
			};
		};

		uart2 {

			uart2m0-xfer {
				rockchip,pins = <0x04 0x03 0x02 0x4b 0x04 0x02 0x02 0x4b>;
				phandle = <0x31>;
			};

			uart2m1-xfer {
				rockchip,pins = <0x02 0x19 0x02 0x4b 0x02 0x18 0x02 0x4b>;
				phandle = <0x86>;
			};

			uart2m2-xfer {
				rockchip,pins = <0x03 0x04 0x02 0x4b 0x03 0x03 0x02 0x4b>;
				phandle = <0x87>;
			};
		};

		tsadc {

			tsadc-otp-gpio {
				rockchip,pins = <0x00 0x06 0x00 0x49>;
				phandle = <0x1c>;
			};

			tsadc-otp-out {
				rockchip,pins = <0x00 0x06 0x02 0x49>;
				phandle = <0x1d>;
			};
		};

		xin32k {

			clkin-32k {
				rockchip,pins = <0x00 0x12 0x01 0x4c>;
				phandle = <0x0a>;
			};

			clkout-32k {
				rockchip,pins = <0x00 0x12 0x01 0x4d>;
				phandle = <0x88>;
			};
		};

		vsel-gpio {
			rockchip,pins = <0x00 0x16 0x00 0x4e>;
			phandle = <0x2c>;
		};

		pwr-key {
			rockchip,pins = <0x00 0x08 0x00 0x49>;
			phandle = <0x4f>;
		};
	};

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff550000 console=ttyFIQ0 init=/init swiotlb=1 kpti=0";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		dma_trans@3c000000 {
			reg = <0x00 0x3c000000 0x00 0x4000000>;
			phandle = <0x11>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0x4f>;
		phandle = <0x89>;

		power {
			gpios = <0x2d 0x08 0x00>;
			label = "GPIO Power";
			linux,code = <0x74>;
			wakeup-source;
		};
	};

	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0x02>;
		rockchip,wake-irq = <0x00>;
		rockchip,irq-mode-enable = <0x00>;
		rockchip,baudrate = <0x16e360>;
		interrupts = <0x00 0xf2 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <0x31>;
		status = "okay";
	};

	vdd-cpu {
		compatible = "regulator-fixed";
		regulator-name = "vdd_cpu";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0xcf850>;
		regulator-max-microvolt = <0xcf850>;
		phandle = <0x04>;
	};

	vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		phandle = <0x2b>;
	};

	display-subsystem {
		compatible = "rockchip,display-subsystem";
		ports = <0x50 0x51>;
		status = "okay";
		phandle = <0x8a>;

		route {

			route-csi {
				status = "disabled";
				connect = <0x3f>;
				phandle = <0x8b>;
			};

			route-dsi {
				status = "disabled";
				connect = <0x41>;
				phandle = <0x8c>;
			};

			route-rgb {
				status = "disabled";
				connect = <0x14>;
				phandle = <0x8d>;
			};
		};
	};

	__symbols__ {
		ddr_timing = "/ddr_timing";
		cpu0 = "/cpus/cpu@0";
		cpu1 = "/cpus/cpu@1";
		cpu0_opp_table = "/cpu0-opp-table";
		rockchip_suspend = "/rockchip-suspend";
		xin24m = "/xin24m";
		xin32k = "/xin32k";
