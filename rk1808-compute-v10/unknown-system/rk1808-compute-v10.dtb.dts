	aliases {
		i2c0 = "/i2c@ff410000";
		i2c1 = "/i2c@ff500000";
		i2c2 = "/i2c@ff504000";
		i2c3 = "/i2c@ff508000";
		i2c4 = "/i2c@ff50c000";
		i2c5 = "/i2c@ff510000";
		serial0 = "/serial@ff430000";
		serial1 = "/serial@ff540000";
		serial2 = "/serial@ff550000";
