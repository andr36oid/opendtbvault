				rockchip,pins = <0x02 0x04 0x03 0xa3>;
				phandle = <0x128>;
			};

			spi2m1-clk {
				rockchip,pins = <0x02 0x05 0x03 0xa3>;
				phandle = <0x129>;
			};

			spi2m1-mosi {
				rockchip,pins = <0x02 0x06 0x03 0xa3>;
				phandle = <0x12a>;
			};

			spi2m1-csn {
				rockchip,pins = <0x02 0x07 0x03 0xa3>;
				phandle = <0x12b>;
			};

			spi2m1-miso-hs {
				rockchip,pins = <0x02 0x04 0x03 0xa3>;
				phandle = <0x12c>;
			};

			spi2m1-clk-hs {
				rockchip,pins = <0x02 0x05 0x03 0xa3>;
				phandle = <0x12d>;
			};

			spi2m1-mosi-hs {
				rockchip,pins = <0x02 0x06 0x03 0xa3>;
				phandle = <0x12e>;
			};

			spi2m1-csn-hs {
				rockchip,pins = <0x02 0x07 0x03 0xa3>;
				phandle = <0x12f>;
			};
		};

		uart0 {

			uart0-xfer {
				rockchip,pins = <0x00 0x0b 0x01 0xa3 0x00 0x0a 0x01 0xa3>;
				phandle = <0x38>;
			};

			uart0-cts {
				rockchip,pins = <0x00 0x0c 0x01 0x9d>;
				phandle = <0x39>;
			};

			uart0-rts {
				rockchip,pins = <0x00 0x0d 0x01 0x9d>;
				phandle = <0x3a>;
			};
		};

		uart1 {

			uart1m0-xfer {
				rockchip,pins = <0x04 0x08 0x02 0xa3 0x04 0x09 0x02 0xa3>;
				phandle = <0x4f>;
			};

			uart1m1-xfer {
				rockchip,pins = <0x01 0x0c 0x03 0xa3 0x01 0x0d 0x03 0xa3>;
				phandle = <0x130>;
			};

			uart1-cts {
				rockchip,pins = <0x04 0x0a 0x02 0x9d>;
				phandle = <0x50>;
			};

			uart1-rts {
				rockchip,pins = <0x04 0x0b 0x02 0x9d>;
				phandle = <0x51>;
			};
		};

		uart2 {

			uart2m0-xfer {
				rockchip,pins = <0x04 0x03 0x02 0xa3 0x04 0x02 0x02 0xa3>;
				phandle = <0x52>;
			};

			uart2m1-xfer {
				rockchip,pins = <0x02 0x19 0x02 0xa3 0x02 0x18 0x02 0xa3>;
				phandle = <0x131>;
			};

			uart2m2-xfer {
				rockchip,pins = <0x03 0x04 0x02 0xa3 0x03 0x03 0x02 0xa3>;
				phandle = <0x132>;
			};
		};

		uart3 {

			uart3m0-xfer {
				rockchip,pins = <0x00 0x14 0x02 0xa3 0x00 0x13 0x02 0xa3>;
				phandle = <0x53>;
			};

			uart3-ctsm0 {
				rockchip,pins = <0x00 0x16 0x02 0x9d>;
				phandle = <0x54>;
			};

			uart3-rtsm0 {
				rockchip,pins = <0x00 0x17 0x02 0x9d>;
				phandle = <0x55>;
			};
		};

		uart4 {

			uart4-xfer {
				rockchip,pins = <0x04 0x0c 0x01 0xa3 0x04 0x0d 0x01 0xa3>;
				phandle = <0x56>;
			};

			uart4-cts {
				rockchip,pins = <0x04 0x0e 0x01 0x9d>;
				phandle = <0x57>;
			};

			uart4-rts {
				rockchip,pins = <0x04 0x0f 0x01 0x9d>;
				phandle = <0x58>;
			};
		};

		uart5 {

			uart5-xfer {
				rockchip,pins = <0x03 0x13 0x02 0xa3 0x03 0x12 0x02 0xa3>;
				phandle = <0x60>;
			};
		};

		uart6 {

			uart6-xfer {
				rockchip,pins = <0x03 0x15 0x02 0xa3 0x03 0x14 0x02 0xa3>;
				phandle = <0x61>;
			};
		};

		uart7 {

			uart7-xfer {
				rockchip,pins = <0x03 0x17 0x02 0xa3 0x03 0x16 0x02 0xa3>;
				phandle = <0x62>;
			};
		};

		tsadc {

			tsadc-otp-gpio {
				rockchip,pins = <0x00 0x06 0x00 0x9d>;
				phandle = <0x1b>;
			};

			tsadc-otp-out {
				rockchip,pins = <0x00 0x06 0x02 0x9d>;
				phandle = <0x1c>;
			};
		};

		xin32k {

			clkin-32k {
				rockchip,pins = <0x00 0x12 0x01 0x9d>;
				phandle = <0x0b>;
			};

			clkout-32k {
				rockchip,pins = <0x00 0x12 0x01 0x9d>;
				phandle = <0x133>;
			};
		};

		pmic {

			en-gpio {
				rockchip,pins = <0x00 0x14 0x00 0xa4>;
				phandle = <0x34>;
			};

			vsel-gpio {
				rockchip,pins = <0x00 0x05 0x00 0xa5>;
				phandle = <0x35>;
			};
		};
	};

	adc-keys {
		compatible = "adc-keys";
		autorepeat;
		io-channels = <0xa6 0x02>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <0x1b7740>;
		poll-interval = <0x64>;
		phandle = <0x134>;
	};

	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0x02>;
		rockchip,wake-irq = <0x00>;
		rockchip,irq-mode-enable = <0x00>;
		rockchip,baudrate = <0x16e360>;
		interrupts = <0x00 0xf2 0x04>;
		status = "okay";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		drm-logo@00000000 {
			compatible = "rockchip,drm-logo";
			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x135>;
		};

		region@110000 {
			reg = <0x00 0x110000 0x00 0xf0000>;
			phandle = <0xa7>;
		};
	};

	ramoops {
		compatible = "ramoops";
		record-size = <0x00 0x30000>;
		console-size = <0x00 0xc0000>;
		ftrace-size = <0x00 0x00>;
		pmsg-size = <0x00 0x00>;
		memory-region = <0xa7>;
		phandle = <0x136>;
	};

	vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		phandle = <0x33>;
	};

	vdd-cpu {
		compatible = "regulator-fixed";
		regulator-name = "vdd_log";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = "\0\f5";
		regulator-max-microvolt = "\0\f5";
		phandle = <0x05>;
	};

	vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		phandle = <0x1d>;
	};

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff550000 console=ttyFIQ0 dump_initrd init=/init swiotlb=1 kpti=0";
	};

