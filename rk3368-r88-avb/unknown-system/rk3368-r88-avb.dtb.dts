	rockchip-suspend {
		compatible = "rockchip,pm-rk3368";
		status = "okay";
		rockchip,sleep-debug-en = <0x01>;
		rockchip,sleep-mode-config = <0x80104>;
		rockchip,wakeup-config = <0x85>;
		phandle = <0x10b>;
	};

	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff690000 swiotlb=1 firmware_class.path=/system/vendor/firmware";
		phandle = <0x10c>;
	};

	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0x02>;
		rockchip,wake-irq = <0x00>;
		rockchip,irq-mode-enable = <0x00>;
		rockchip,baudrate = <0x1c200>;
		pinctrl-names = "default";
		pinctrl-0 = <0x48>;
		interrupts = <0x00 0x9a 0x04>;
		phandle = <0x10d>;
	};

	ramoops_mem {
		reg = <0x00 0x110000 0x00 0xf0000>;
		reg-names = "ramoops_mem";
		phandle = <0x8f>;
	};

	ramoops {
		compatible = "ramoops";
		record-size = <0x00 0x20000>;
		console-size = <0x00 0x80000>;
		ftrace-size = <0x00 0x00>;
		pmsg-size = <0x00 0x50000>;
		memory-region = <0x8f>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		drm-logo@00000000 {
			compatible = "rockchip,drm-logo";
			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x7a>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x2000000>;
			linux,cma-default;
		};
	};

	ion {
		compatible = "rockchip,ion";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cma-heap {
			reg = <0x00 0x2800000>;
		};

		system-heap {
		};
	};

	firmware {

		android {
			compatible = "android,firmware";
			boot_devices = "ff0f0000.dwmmc,ff400000.nandc";
			phandle = <0x10e>;

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,dtbo";
			};

			fstab {
				compatible = "android,fstab";

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
					fsmgr_flags = "wait,avb";
				};
			};
		};
	};

	rga@ff920000 {
		compatible = "rockchip,rga2";
		dev_mode = <0x01>;
		reg = <0x00 0xff920000 0x00 0x1000>;
		interrupts = <0x00 0x12 0x04>;
		clocks = <0x0a 0xc8 0x0a 0x1d6 0x0a 0x6a>;
		clock-names = "aclk_rga\0hclk_rga\0clk_rga";
		dma-coherent;
		status = "okay";
	};

	dwc-control-usb {
		compatible = "rockchip,rk3368-dwc-control-usb";
		status = "okay";
		rockchip,grf = <0x3a>;
		grf-offset = <0x4bc>;
		interrupts = <0x00 0x5d 0x04 0x00 0x5e 0x04 0x00 0x5f 0x04 0x00 0x60 0x04>;
		interrupt-names = "otg_id\0otg_bvalid\0otg_linestate\0host0_linestate";
		clocks = <0x0a 0x1bf>;
		clock-names = "hclk_usb_peri";
		otg_drv_gpio = <0x2e 0x19 0x01>;
		rockchip,remote_wakeup;
		rockchip,usb_irq_wakeup;
		phandle = <0x10f>;

		usb_bc {
			compatible = "inno,phy";
			regbase = "/dwc-control-usb";
			rk_usb,bvalid = <0x4bc 0x17 0x01>;
			rk_usb,iddig = <0x4bc 0x1a 0x01>;
			rk_usb,vdmsrcen = <0x718 0x0c 0x01>;
			rk_usb,vdpsrcen = <0x718 0x0b 0x01>;
			rk_usb,rdmpden = <0x718 0x0a 0x01>;
			rk_usb,idpsrcen = <0x718 0x09 0x01>;
			rk_usb,idmsinken = <0x718 0x08 0x01>;
			rk_usb,idpsinken = <0x718 0x07 0x01>;
			rk_usb,dpattach = <0x4b8 0x1f 0x01>;
			rk_usb,cpdet = <0x4b8 0x1e 0x01>;
			rk_usb,dcpattach = <0x4b8 0x1d 0x01>;
		};
	};

	xin32k {
		status = "okay";
		compatible = "pwm-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		clock-output-names = "xin32k";
		pwms = <0x90 0x00 0x7736 0x00>;
		phandle = <0x110>;
	};

	sound {
		compatible = "rockchip,rk3368-hdmi-analog";
		rockchip,cpu = <0x91>;
		rockchip,codec = <0x92 0x93>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x94>;
		phandle = <0x111>;

		button@0 {
			gpio-key,wakeup = <0x01>;
			gpios = <0x2e 0x02 0x01>;
			label = "GPIO Power";
			linux,code = <0x74>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";
		phandle = <0x112>;

		work {
			gpios = <0x3c 0x1d 0x00>;
			label = "r88:green:led";
			pinctrl-names = "default";
			pinctrl-0 = <0x95>;
		};
	};

	vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x39fbc0>;
		regulator-max-microvolt = <0x39fbc0>;
		phandle = <0x30>;
	};

	vcc-host {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <0x2e 0x04 0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <0x96>;
		regulator-name = "vcc_host";
		regulator-always-on;
		phandle = <0x113>;
	};

	vcc-phy-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_phy";
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x3b>;
	};

	gmac-clk {
		compatible = "fixed-clock";
		clock-frequency = <0x7735940>;
		clock-output-names = "ext_gmac";
		#clock-cells = <0x00>;
		phandle = <0x114>;
	};

	sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <0x97 0x01>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <0x98>;
		reset-gpios = <0x3c 0x04 0x01>;
		phandle = <0x19>;
	};

	wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <0x3a>;
		wifi_chip_type = "rtl8189es";
		sdio_vref = <0x708>;
		WIFI,host_wake_irq = <0x3c 0x06 0x00>;
		status = "okay";
	};

	wireless-bluetooth {
		compatible = "bluetooth-platdata";
		clocks = <0x97 0x01>;
		clock-names = "ext_clock";
		uart_rts_gpios = <0x99 0x1b 0x01>;
		pinctrl-names = "default\0rts_gpio";
		pinctrl-0 = <0x9a>;
		pinctrl-1 = <0x9b>;
		BT,reset_gpio = <0x3c 0x05 0x00>;
		BT,wake_gpio = <0x3c 0x02 0x00>;
		BT,wake_host_irq = <0x3c 0x07 0x00>;
		status = "okay";
	};

