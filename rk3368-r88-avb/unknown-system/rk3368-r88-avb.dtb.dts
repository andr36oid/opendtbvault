		rockchip,leakage-voltage-sel = <0x01 0x18 0x00 0x19 0x32 0x01 0x33 0xfe 0x02>;
		nvmem-cells = <0x14>;
		nvmem-cell-names = "cpu_leakage";
		rockchip,avs = <0x01>;
